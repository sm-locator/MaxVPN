# Supply TEST_DATABASE_URL, TEST_POSTGRES_PASSWORD and TEST_SECRET_KEY from the test environment.
POSTGRES_DB=maxvpn_test
POSTGRES_USER=maxvpn
POSTGRES_PASSWORD=${TEST_POSTGRES_PASSWORD}

DATABASE_URL=${TEST_DATABASE_URL}

SECRET_KEY=${TEST_SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

WIREGUARD_SERVER_PUBLIC_KEY=test_public_key
WIREGUARD_ENDPOINT=vpn.test:51820
WIREGUARD_DNS=1.1.1.1
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
WIREGUARD_PERSISTENT_KEEPALIVE=25
